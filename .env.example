# Aether Fleet Template — environment example
# This app is a client-only Vite SPA. No server secrets are required to run.
#
# Optional Vite public vars (prefix with VITE_ to expose to the browser):
# VITE_APP_TITLE="Aether Fleet Template"
# VITE_DEFAULT_THEME="aether-purple"
#
# Theme loading (client-side — not env vars):
#   Query param:  /?theme=ocean-teal   (loads public/themes/<slug>.json)
#   localStorage keys (set by Theme Studio / Fleet Dashboard):
#     aether-fleet-theme           Active working theme JSON
#     aether-fleet-sites           Fleet site registry
#     aether-fleet-theme-library   Named theme snapshots
#     aether-fleet-activity        Recent activity feed
#     aether-fleet-last-saved      ISO timestamp of last theme save
#
# Copy this file if you add real VITE_* vars later:
#   cp .env.example .env
#   # then edit .env (gitignored)
